# Required: replace with a unique password, at least 12 characters.
ROADMAP_PASSWORD=
# false only for loopback HTTP development. Set true behind HTTPS.
ROADMAP_COOKIE_SECURE=false
# Explicitly allow fictional demo insertion into an empty database.
ROADMAP_DEMO=true
# Optional Yandex Tracker credential; integration remains disabled until configured in Settings.
# OAuth token, or an operator-renewed IAM token when Bearer authentication is selected.
ROADMAP_TRACKER_TOKEN=
